# Copy this file to .env.local for local development, and add the same values
# in Vercel under Project Settings > Environment Variables for the live site.

# The public address of the site, without a trailing slash.
# Locally: http://localhost:3000. Live: https://your-domain.com (or the .vercel.app address).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# From Supabase: Project Settings > API Keys (and Data API for the URL).
# The publishable key is safe to expose in the browser; row level security protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# The only email address allowed into /admin. It must match the row in the admins table.
ADMIN_EMAIL=eeshankarra@gmail.com

# A long random string used to hash login attempts for rate limiting. Keep it secret.
# Make one with: openssl rand -hex 32
RATE_LIMIT_SECRET=

# A long random string that Vercel Cron sends to /api/keepalive. Keep it secret.
# Make one with: openssl rand -hex 32
CRON_SECRET=
